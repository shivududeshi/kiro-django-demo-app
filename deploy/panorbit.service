# Systemd service file for Gunicorn / Panorbit Django app
# Place at: /etc/systemd/system/panorbit.service
#
# Then run:
#   sudo systemctl daemon-reload
#   sudo systemctl enable panorbit
#   sudo systemctl start panorbit

[Unit]
Description=Panorbit Django App (Gunicorn)
After=network.target mysql.service

[Service]
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/kiro-django-demo-app

# Load environment variables from .env file
EnvironmentFile=/var/www/kiro-django-demo-app/.env

# Activate virtualenv and start gunicorn
ExecStart=/var/www/kiro-django-demo-app/envs/bin/gunicorn \
          --config /var/www/kiro-django-demo-app/gunicorn.conf.py \
          panorbit.wsgi:application

ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
TimeoutStopSec=5
PrivateTmp=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
